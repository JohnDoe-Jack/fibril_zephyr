#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	zephyr,user {
		pwms = <&pwm 4 PWM_MSEC(20) PWM_POLARITY_NORMAL>,
		       <&pwm 5 PWM_MSEC(20) PWM_POLARITY_NORMAL>,
		       <&pwm 6 PWM_MSEC(20) PWM_POLARITY_NORMAL>,
		       <&pwm 9 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
	};
};
