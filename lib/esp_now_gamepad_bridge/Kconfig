menuconfig ESP_NOW_GAMEPAD_BRIDGE
	bool "ESP-NOW gamepad UART bridge"
	depends on SERIAL && COBS
	depends on SERIAL_SUPPORT_ASYNC || SERIAL_SUPPORT_INTERRUPT
	select UART_USE_RUNTIME_CONFIGURE
	select CRC
	help
	  Receive COBS/CRC-8 gamepad snapshots on one dedicated UART.
	  The application supplies the UART device. No data is transmitted.

if ESP_NOW_GAMEPAD_BRIDGE

choice ESP_NOW_GAMEPAD_BRIDGE_RX_API
	prompt "UART receive API"
	default ESP_NOW_GAMEPAD_BRIDGE_ASYNC if SERIAL_SUPPORT_ASYNC
	default ESP_NOW_GAMEPAD_BRIDGE_INTERRUPT

config ESP_NOW_GAMEPAD_BRIDGE_ASYNC
	bool "Asynchronous UART"
	depends on SERIAL_SUPPORT_ASYNC
	select UART_ASYNC_API

config ESP_NOW_GAMEPAD_BRIDGE_INTERRUPT
	bool "Interrupt-driven UART"
	depends on SERIAL_SUPPORT_INTERRUPT
	select UART_INTERRUPT_DRIVEN
	help
	  Use for controllers without the async API, including RP2350 PL011.

endchoice

config ESP_NOW_GAMEPAD_BRIDGE_TIMEOUT_MS
	int "Gamepad link timeout in milliseconds"
	default 100
	range 20 5000
	help
	  Neutralize state unless a new valid sequence arrives in this interval.
	  Duplicate or malformed frames do not refresh the deadline.

endif # ESP_NOW_GAMEPAD_BRIDGE
