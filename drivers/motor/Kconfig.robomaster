config MOTOR_DJI_ROBOMASTER
	bool "DJI RoboMaster C610/C620 motor driver"
	default y
	depends on CAN
	depends on DT_HAS_DJI_ROBOMASTER_ENABLED
	help
	  Enable support for DJI RoboMaster C610/C620 motor controllers exposed
	  as one logical motor device per motor.

if MOTOR_DJI_ROBOMASTER

config MOTOR_DJI_ROBOMASTER_TX_STACK_SIZE
	int "RoboMaster transmit worker stack size"
	default 1024
	range 512 8192

config MOTOR_DJI_ROBOMASTER_TX_THREAD_PRIORITY
	int "RoboMaster transmit worker priority"
	default 5
	range -16 15
	help
	  Preemptible worker priority. Keep this lower priority than the application
	  control thread; CAN submission never runs in that control thread.

endif
